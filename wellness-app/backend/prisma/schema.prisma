// Wellness Dashboard - Database Schema
// PostgreSQL via Prisma. Every health record carries a timestamp for trend
// analysis and historical export. Designed to stay modular: new integrations
// (wearables, smart scales, barcode scanners) can add tables/columns without
// touching this core model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  unitSystem   String   @default("imperial") @map("unit_system") // imperial | metric
  heightInches Float?   @map("height_inches")
  theme        String   @default("system") // light | dark | system
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  goals              Goal[]
  vitalRange         VitalRange?
  weightEntries      WeightEntry[]
  bodyMeasurements   BodyMeasurement[]
  bloodPressure      BloodPressureReading[]
  vitals             VitalsReading[]
  foods              Food[]
  recipes            Recipe[]
  meals              Meal[]
  mealPlans          MealPlan[]
  groceryLists       GroceryList[]
  pantryItems        PantryItem[]
  workoutSessions    WorkoutSession[]
  workoutPrograms    WorkoutProgram[]
  programEnrollments ProgramEnrollment[]
  habits             Habit[]
  habitEntries       HabitEntry[]
  waterEntries       WaterEntry[]
  sleepEntries       SleepEntry[]
  stepEntries        StepEntry[]
  aiConversations    AIConversation[]
  aiInsights         AIInsight[]
  preferences        UserPreference[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique @map("refresh_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. login, password_change, export, account_delete
  detail    String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Goals
// ---------------------------------------------------------------------------

model Goal {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true) @map("is_active")

  startingWeight Float?    @map("starting_weight")
  goalWeight     Float?    @map("goal_weight")
  targetDate     DateTime? @map("target_date")

  calorieTarget Int? @map("calorie_target")
  proteinTarget Int? @map("protein_target")
  carbTarget    Int? @map("carb_target")
  fatTarget     Int? @map("fat_target")
  fiberTarget   Int? @map("fiber_target")
  sodiumTarget  Int? @map("sodium_target")
  waterTargetOz Int? @map("water_target_oz")

  stepsTarget           Int? @map("steps_target")
  workoutsPerWeek       Int? @map("workouts_per_week")
  exerciseMinutesTarget Int? @map("exercise_minutes_target")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("goals")
}

// User-defined "normal for me" ranges for BP/vitals. Purely informational —
// used to flag a reading as outside the user's own range, never to diagnose.
model VitalRange {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  systolicMin  Int? @map("systolic_min")
  systolicMax  Int? @map("systolic_max")
  diastolicMin Int? @map("diastolic_min")
  diastolicMax Int? @map("diastolic_max")
  pulseMin     Int? @map("pulse_min")
  pulseMax     Int? @map("pulse_max")

  restingHRMin       Int?   @map("resting_hr_min")
  restingHRMax       Int?   @map("resting_hr_max")
  spo2Min            Float? @map("spo2_min")
  temperatureMin     Float? @map("temperature_min")
  temperatureMax     Float? @map("temperature_max")
  respiratoryRateMin Int?   @map("respiratory_rate_min")
  respiratoryRateMax Int?   @map("respiratory_rate_max")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vital_ranges")
}

// ---------------------------------------------------------------------------
// Weight & body metrics
// ---------------------------------------------------------------------------

model WeightEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight     Float
  bodyFatPct Float?   @map("body_fat_pct")
  recordedAt DateTime @map("recorded_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@map("weight_entries")
}

model BodyMeasurement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waist      Float?
  chest      Float?
  hips       Float?
  neck       Float?
  arm        Float?
  thigh      Float?
  recordedAt DateTime @map("recorded_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@map("body_measurements")
}

// ---------------------------------------------------------------------------
// Blood pressure & vitals
// ---------------------------------------------------------------------------

model BloodPressureReading {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systolic   Int
  diastolic  Int
  pulse      Int?
  recordedAt DateTime @map("recorded_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@map("blood_pressure")
}

model VitalsReading {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restingHeartRate Int?     @map("resting_heart_rate")
  bloodOxygen      Float?   @map("blood_oxygen")
  temperature      Float?
  respiratoryRate  Int?     @map("respiratory_rate")
  recordedAt       DateTime @map("recorded_at")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@map("vitals")
}

// ---------------------------------------------------------------------------
// Nutrition: foods, recipes, meals
// ---------------------------------------------------------------------------

model Food {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id") // null = global/shared food
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  servingSize String   @map("serving_size")
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sodium      Float?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  isCustom    Boolean  @default(true) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  mealItems     MealItem[]
  mealPlanItems MealPlanItem[]

  @@index([userId, name])
  @@map("foods")
}

model Recipe {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  servings           Int      @default(1)
  prepMinutes        Int?     @map("prep_minutes")
  cookMinutes        Int?     @map("cook_minutes")
  ingredients        Json // [{name, quantity, unit}]
  instructions       Json // [string]
  caloriesPerServing Float?   @map("calories_per_serving")
  proteinPerServing  Float?   @map("protein_per_serving")
  carbsPerServing    Float?   @map("carbs_per_serving")
  fatPerServing      Float?   @map("fat_per_serving")
  fiberPerServing    Float?   @map("fiber_per_serving")
  sodiumPerServing   Float?   @map("sodium_per_serving")
  tags               String[] @default([])
  isFavorite         Boolean  @default(false) @map("is_favorite")
  source             String   @default("user") // user | ai
  createdAt          DateTime @default(now()) @map("created_at")

  mealItems     MealItem[]
  mealPlanItems MealPlanItem[]

  @@index([userId])
  @@map("recipes")
}

model Meal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  String   @map("meal_type") // breakfast | lunch | dinner | snack
  eatenAt   DateTime @map("eaten_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  items MealItem[]

  @@index([userId, eatenAt])
  @@map("meals")
}

model MealItem {
  id       String  @id @default(uuid())
  mealId   String  @map("meal_id")
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId   String? @map("food_id")
  food     Food?   @relation(fields: [foodId], references: [id])
  recipeId String? @map("recipe_id")
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  description String? // free-text fallback when no food/recipe link
  quantity    Float   @default(1)

  // Snapshot of macros at time of logging, so later edits to a Food/Recipe
  // don't rewrite history.
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float?
  sodium   Float?

  @@index([mealId])
  @@map("meal_items")
}

// ---------------------------------------------------------------------------
// Meal planning & grocery
// ---------------------------------------------------------------------------

model MealPlan {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  generatedBy String   @default("ai") @map("generated_by") // ai | user
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  items        MealPlanItem[]
  groceryLists GroceryList[]

  @@index([userId, startDate])
  @@map("meal_plans")
}

model MealPlanItem {
  id           String   @id @default(uuid())
  mealPlanId   String   @map("meal_plan_id")
  mealPlan     MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOffset    Int      @map("day_offset") // 0-6 within the plan
  mealType     String   @map("meal_type")
  foodId       String?  @map("food_id")
  food         Food?    @relation(fields: [foodId], references: [id])
  recipeId     String?  @map("recipe_id")
  recipe       Recipe?  @relation(fields: [recipeId], references: [id])
  title        String
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?
  sodium       Float?
  ingredients  Json?
  instructions Json?

  @@index([mealPlanId, dayOffset])
  @@map("meal_plan_items")
}

model GroceryList {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId String?   @map("meal_plan_id")
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id])
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")

  items GroceryItem[]

  @@index([userId])
  @@map("grocery_lists")
}

model GroceryItem {
  id            String      @id @default(uuid())
  groceryListId String      @map("grocery_list_id")
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  name          String
  quantity      String?
  category      String      @default("other") // produce, meat, dairy, frozen, pantry, grains, canned, spices, beverages, other
  purchased     Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([groceryListId])
  @@map("grocery_items")
}

model PantryItem {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  quantity String?
  addedAt  DateTime @default(now()) @map("added_at")

  @@index([userId])
  @@map("pantry_items")
}

// ---------------------------------------------------------------------------
// Exercise
// ---------------------------------------------------------------------------

model Exercise {
  id          String  @id @default(uuid())
  name        String  @unique
  category    String // walking, running, cycling, strength, resistance_bands, kettlebells, bodyweight, sports, mobility
  equipment   String? // e.g. "none", "dumbbell", "resistance band", "kettlebell"
  muscleGroup String? @map("muscle_group") // e.g. "chest", "legs", "core", "back", "full body"
  description String? // brief form/cueing notes

  sets             WorkoutSet[]
  programExercises WorkoutProgramExercise[]

  @@map("exercises")
}

model WorkoutSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // matches exercise category, e.g. "strength", "walking"
  startedAt       DateTime @map("started_at")
  durationMinutes Int?     @map("duration_minutes")
  distanceMiles   Float?   @map("distance_miles")
  caloriesBurned  Int?     @map("calories_burned")
  notes           String?
  generatedBy     String   @default("user") @map("generated_by") // user | ai
  createdAt       DateTime @default(now()) @map("created_at")

  // Set when this session was logged against a specific day of a program
  // the user is following — lets the app track program adherence.
  programDayId String?            @map("program_day_id")
  programDay   WorkoutProgramDay? @relation(fields: [programDayId], references: [id])

  sets WorkoutSet[]

  @@index([userId, startedAt])
  @@map("workout_sessions")
}

model WorkoutSet {
  id           String         @id @default(uuid())
  sessionId    String         @map("session_id")
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId   String?        @map("exercise_id")
  exercise     Exercise?      @relation(fields: [exerciseId], references: [id])
  exerciseName String         @map("exercise_name")
  sets         Int?
  reps         Int?
  resistance   String?
  order        Int            @default(0)

  @@index([sessionId])
  @@map("workout_sets")
}

// ---------------------------------------------------------------------------
// Workout programs — reusable multi-week templates built from the exercise
// library. userId null = a built-in/shared program (same pattern as global
// Food entries), so starter programs are visible to every account.
// ---------------------------------------------------------------------------

model WorkoutProgram {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  durationWeeks Int      @map("duration_weeks")
  daysPerWeek   Int      @map("days_per_week")
  difficulty    String   @default("beginner") // beginner | intermediate | advanced
  equipment     String[] @default([]) // e.g. ["bodyweight"], ["kettlebell"]
  createdAt     DateTime @default(now()) @map("created_at")

  days        WorkoutProgramDay[]
  enrollments ProgramEnrollment[]

  @@map("workout_programs")
}

model WorkoutProgramDay {
  id         String         @id @default(uuid())
  programId  String         @map("program_id")
  program    WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int            @map("week_number")
  dayNumber  Int            @map("day_number") // 1-7 within the week
  title      String
  notes      String?

  exercises WorkoutProgramExercise[]
  sessions  WorkoutSession[]

  @@index([programId, weekNumber, dayNumber])
  @@map("workout_program_days")
}

model WorkoutProgramExercise {
  id              String            @id @default(uuid())
  programDayId    String            @map("program_day_id")
  programDay      WorkoutProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exerciseId      String?           @map("exercise_id")
  exercise        Exercise?         @relation(fields: [exerciseId], references: [id])
  exerciseName    String            @map("exercise_name") // snapshot, same free-text pattern as WorkoutSet
  sets            Int?
  reps            Int?
  durationSeconds Int?              @map("duration_seconds") // for timed moves like planks
  restSeconds     Int?              @map("rest_seconds")
  order           Int               @default(0)

  @@index([programDayId])
  @@map("workout_program_exercises")
}

model ProgramEnrollment {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId   String         @map("program_id")
  program     WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  startedAt   DateTime       @default(now()) @map("started_at")
  currentWeek Int            @default(1) @map("current_week")
  currentDay  Int            @default(1) @map("current_day")
  active      Boolean        @default(true)
  completedAt DateTime?      @map("completed_at")

  @@index([userId, active])
  @@map("program_enrollments")
}

// ---------------------------------------------------------------------------
// Habits
// ---------------------------------------------------------------------------

model Habit {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  isBuiltIn     Boolean  @default(false) @map("is_built_in") // water, steps, exercise, meal_logging, sleep, meal_prep, nutrition_goals, weekly_weigh_in
  targetPerWeek Int      @default(7) @map("target_per_week")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  entries HabitEntry[]

  @@index([userId])
  @@map("habits")
}

model HabitEntry {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_entries")
}

// ---------------------------------------------------------------------------
// Water & sleep
// ---------------------------------------------------------------------------

model WaterEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOz   Float    @map("amount_oz")
  recordedAt DateTime @map("recorded_at")

  @@index([userId, recordedAt])
  @@map("water_entries")
}

model SleepEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  hours     Float
  quality   Int? // 1-5
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("sleep_entries")
}

model StepEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  steps     Int
  source    String   @default("manual") // manual | integration
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("step_entries")
}

// ---------------------------------------------------------------------------
// AI Coach
// ---------------------------------------------------------------------------

model AIConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Coach conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIInsight {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // daily | weekly | monthly
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  content     Json // structured insight: summary, wins, improvements, focus
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, type, periodStart])
  @@map("ai_insights")
}

// ---------------------------------------------------------------------------
// Preferences (AI Coach memory)
// ---------------------------------------------------------------------------

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // favorite_foods | disliked_foods | dietary_restrictions | favorite_meals | meal_times | cooking_prefs | workout_schedule | weekly_goals | successful_strategies
  key       String
  value     Json
  source    String   @default("user") @map("source") // user | ai_learned
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category, key])
  @@index([userId, category])
  @@map("user_preferences")
}
