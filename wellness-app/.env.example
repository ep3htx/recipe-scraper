# =============================================================================
# Wellness Dashboard — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Generate strong secrets with: openssl rand -hex 32
# =============================================================================

# ---- General ------------------------------------------------------------
NODE_ENV=production
# Public domain (or LAN hostname / IP) you access the app through.
APP_DOMAIN=wellness.example.com
# Full origin the browser uses — used for CORS + cookie scoping.
PUBLIC_ORIGIN=https://wellness.example.com

# ---- Database -------------------------------------------------------------
POSTGRES_USER=wellness
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=wellness
# Must match the three values above: postgresql://USER:PASSWORD@postgres:5432/DB
DATABASE_URL=postgresql://wellness:changeme_use_a_strong_password@postgres:5432/wellness

# ---- Auth -------------------------------------------------------------
JWT_ACCESS_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=changeme_generate_a_different_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Set to false only for local HTTP development without TLS.
COOKIE_SECURE=true
# When true, only one account can ever be registered on this instance
# (the personal-use default). Set to false to allow multiple household members.
SINGLE_USER_MODE=true

# ---- AI provider (see backend/src/services/ai) -----------------------------
# disabled | openai | ollama
AI_PROVIDER=disabled
AI_MODEL=llama3
# Required only when AI_PROVIDER=openai. Backend-only — never sent to the frontend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required only when AI_PROVIDER=ollama. Point at a local or LAN Ollama instance.
OLLAMA_BASE_URL=http://ollama:11434

# ---- Backend service --------------------------------------------------
BACKEND_PORT=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Frontend service ---------------------------------------------------
FRONTEND_PORT=3000
# Browser-visible base path for API calls — always proxied through Nginx.
VITE_API_BASE_URL=/api

# ---- Nginx / HTTPS ------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# nginx/conf.d/wellness.conf expects your certificate and key at
# nginx/certs/fullchain.pem and nginx/certs/privkey.pem (that directory is
# bind-mounted into the nginx container). Use Let's Encrypt/certbot output,
# or run scripts/generate-self-signed-cert.sh for LAN-only access.

# ---- Backups --------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
